  "repository": "https://github.com/hi-mundo/structured-vibe-code-plugin",
  "license": "MIT",
  "keywords": ["vibecoding", "vibe-coding", "human-in-the-loop", "pair-programming", "code-review", "guardrails", "claude-code", "codex", "developer-tools", "intent-to-behavior", "execution-slices", "decision-log"],
  "commands": "./commands/",
  "skills": ["./skills/vibecode", "./skills/asking", "./skills/prior-art", "./skills/understand", "./skills/execution-slices", "./skills/review-i2b"],
  "hooks": "./hooks/hooks.json"
}
