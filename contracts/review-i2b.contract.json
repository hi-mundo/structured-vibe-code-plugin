{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "review-i2b/v1",
  "artifacts": {"decision_log": ".decisions.jsonl"},
  "history": {"minimum_revisions": 3},
  "decision_log": {
    "minimum_records": 200,
    "soft_max_bytes": 1048576,
    "compaction_target_bytes": 921600,
    "required_fields": ["id", "timestamp", "domain", "scope", "decision", "reason", "status", "paths", "fingerprint"],
    "terminal_statuses": ["accepted", "rejected", "failed", "superseded"],
    "blocking_statuses": ["rejected", "failed"]
  },
  "guardrails": {
    "DEC003": "exact fingerprint repeats a rejected approach",
    "DEC004": "exact fingerprint repeats a failed approach",
    "DEC009": "human override is required to repeat a blocked approach",
    "DEC010": "decision log is malformed"
  }
}
